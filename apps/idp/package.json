{
  "name": "idp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "bootstrap:tenant": "tsx src/scripts/bootstrap-tenant.ts",
    "seed:cnae": "tsx src/scripts/seed-cnae.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "fast-check": "^4.8.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "jszip": "^3.10.2",
    "pdfkit": "^0.15.2",
    "pg": "^8.21.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-email": "^6.5.0",
    "resend": "^6.12.4",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  }
}
