{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm routes:generate && tsc -b && vite build",
    "lint": "biome lint .",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "pnpm routes:generate && tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "record:risk-one": "node scripts/journey-recordings/record-risk-one.mjs",
    "record:risk-two:no-inspection": "node scripts/journey-recordings/record-risk-two-no-inspection.mjs",
    "record:risk-two:with-inspection": "node scripts/journey-recordings/record-risk-two-with-inspection.mjs",
    "record:risk-two:requirement": "node scripts/journey-recordings/record-risk-two-requirement.mjs",
    "record:journeys": "pnpm record:risk-one && pnpm record:risk-two:no-inspection && pnpm record:risk-two:with-inspection && pnpm record:risk-two:requirement",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "ky": "^2.0.2",
    "lucide-react": "^1.14.0",
    "maplibre-gl": "5.24.0",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.75.0",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/router-cli": "^1.166.42",
    "@tanstack/router-plugin": "^1.167.34",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.1.1",
    "msw": "^2.14.3",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  }
}
