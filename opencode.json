{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "apps/idp/.env": "deny",
      "**/.env.example": "allow",
      "apps/idp/.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "apps/idp/.env": "deny",
      "**/.env.example": "allow",
      "apps/idp/.env.example": "allow"
    },
    "grep": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "apps/idp/.env": "deny",
      "**/.env.example": "allow",
      "apps/idp/.env.example": "allow"
    }
  },
  "watcher": {
    "ignore": [
      "**/.env",
      "**/.env.local",
      "**/.env.development",
      "**/.env.production",
      "**/.env.staging",
      "**/.env.test",
      "apps/idp/.env"
    ]
  },
  "mcp": {
    "Figma": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "Context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
